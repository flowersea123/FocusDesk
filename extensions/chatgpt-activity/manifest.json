{
  "manifest_version": 3,
  "name": "FocusDesk · ChatGPT 活动",
  "version": "1.0.0",
  "description": "在本机记录期间报告 ChatGPT 网页的生成状态。",
  "key": "",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "activity.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "storage"
  ]
}
