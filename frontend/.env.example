# Defaults when VITE_DATA_SOURCE is unset:
# npm run dev -> browser-local Mock fixtures
# npm run build -> same-origin local demo HTTP service

# Explicit overrides apply to both development and build:
# VITE_DATA_SOURCE=mock
# VITE_DATA_SOURCE=http
# VITE_API_BASE_URL=http://127.0.0.1:8787
# Leave VITE_API_BASE_URL unset for same-origin /api/v1/daily-overview.
# A separate dev origin requires the service to allow that origin; no Vite proxy is configured.
# Browser-visible variables must never contain secrets.
