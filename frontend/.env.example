# The root "npm run dev" starts the real local Hub with a same-origin Vite proxy.
# Standalone "npm --prefix frontend run dev" uses browser-local mock fixtures.
# Production builds default to same-origin HTTP. Optional standalone/build settings:
# VITE_DATA_SOURCE=mock
# VITE_DATA_SOURCE=http
# VITE_API_BASE_URL=http://127.0.0.1:8787
# Leave VITE_API_BASE_URL unset for the default /api proxy or same-origin Hub.
# All VITE_ values are visible in the browser.
